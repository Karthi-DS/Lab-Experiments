<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <% if(products.length==0) {%>
    <h1>No products to display</h1>
    <%}else{%>
    <h1>Products</h1>
    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p=>{%>
        <tr>
          <td><%=p.id%></td>
          <td><%=p.name%></td>
          <td><%=p.price%></td>
          <td><%=p.stock%></td>
          <td>
            <a href="/route/editProduct/<%=p.id%>">Edit</a>
            <br />
            <a href="/route/deleteProduct/<%=p.id%>">Delete</a></td>
        </tr>
        <%})%>
      </tbody>
    </table>
    <%}%>
  </body>
</html>
